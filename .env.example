# Copy to .env for local Compose use. Keep .env out of version control.
MYSQL_DATABASE=relayops
MYSQL_USER=relay
MYSQL_PASSWORD=local_only_change_me
MYSQL_ROOT_PASSWORD=local_root_only_change_me

# Optional truthful deployment metadata shown by the dashboard.
APP_VERSION=local
APP_REVISION=
APP_IMAGE_DIGEST=
APP_ENVIRONMENT=local
APP_PORT=8080

# Set true only when serving the app over HTTPS.
COOKIE_SECURE=false
